/*-----------------------------
	Wcorr.RC resource script 0892
  -----------------------------*/

#include "3dview.h"

//WCORRBMP BITMAP "3dview.bmp"

AboutBox DIALOG 20, 20, 160, 80
STYLE WS_POPUP | WS_DLGFRAME
CLASS "bordlg"
{
 CTEXT "  3dview", -1, 55, 10, 55, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
 CTEXT "Copyright (c) Ed Nieuwenhuys, 1995", -1, 20, 40, 130, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
 CONTROL "OK", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 64, 60, 32, 14
 CTEXT "V 1.0", -1, 55, 19, 55, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
 CONTROL "", 101, "BorShade", BSS_GROUP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 55, 10, 55, 20
 ICON "3dview", -1, 12, 11, 13, 13
}

KNOPPEN DIALOG PRELOAD MOVEABLE DISCARDABLE 193, 119, 173, 82
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION
CLASS "bordlg"
CAPTION "3dview Ed Nieuwenhuys"
{
 PUSHBUTTON "&Load bitmaps", IDC_BMPS, 5, 20, 80, 10
 CONTROL "&Knip", IDC_KNIP, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 90, 20, 35, 10
 CONTROL "&Test", IDC_TESTHALF, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 130, 61, 30, 10
 PUSHBUTTON "&Random background", IDM_VIEW, 5, 35, 80, 10
 PUSHBUTTON "&?About", IDM_ABOUTP, 130, 5, 35, 10, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Quit", IDM_CLOSE, 5, 5, 80, 10, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Font", IDM_FONT, 130, 20, 35, 10
 PUSHBUTTON "&A:", IDM_DRIVEA, 90, 5, 15, 10
 PUSHBUTTON "&B:", IDM_DRIVEB, 110, 5, 15, 10
 CTEXT "Colums", -1, 10, 52, 35, 8
 CTEXT "Depth", -1, 55, 52, 35, 8
 EDITTEXT IDC_COLS, 10, 60, 35, 12, ES_WANTRETURN | WS_BORDER | WS_TABSTOP
 EDITTEXT IDC_DEPTH, 55, 60, 35, 12, ES_WANTRETURN | WS_BORDER | WS_TABSTOP
 CONTROL "Testsize (%)", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_CENTER | WS_CHILD | WS_VISIBLE, 95, 48, 70, 28
 EDITTEXT IDC_TESTSIZE, 100, 60, 25, 12, ES_CENTER | ES_WANTRETURN | WS_BORDER | WS_TABSTOP
}

ListSelect DIALOG 19, 22, 258, 201
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CLASS "bordlg"
CAPTION "Select two or more PIC files with CTRL+Mouseclick"
FONT 12, "System"
BEGIN
	CONTROL "Select", 101, "LISTBOX", LBS_NOTIFY | LBS_MULTIPLESEL | LBS_MULTICOLUMN | LBS_EXTENDEDSEL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_HSCROLL, 5, 5, 250, 170
	PUSHBUTTON "OK", IDOK, 96, 180, 65, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END


INPUTDIALOG DIALOG 50, 78, 111, 83
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CLASS "BorDlg_Gray"
CAPTION "Disk volume name"
FONT 8, "MS Sans Serif"
{
 CONTROL "", -1, "BorShade", BSS_HDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 0, 56, 189, 3
 EDITTEXT IDM_INPUT, 20, 33, 65, 12
 CONTROL "", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 20, 65, 37, 25
 CONTROL "", IDCANCEL, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 76, 65, 37, 25
 CTEXT "11 characters maximal", -1, 5, 5, 102, 11
}

