NAME           WCORR
DESCRIPTION    'BLAST Version 1'
;STUB           'WINSTUB.EXE'
EXETYPE        WINDOWS

CODE           PRELOAD MOVEABLE DISCARDABLE
DATA           PRELOAD MOVEABLE MULTIPLE

HEAPSIZE       1024
STACKSIZE      8192
EXPORTS        WNDPROC
			   KNOPPENPROC
			   ABOUTDLGPROC
			  ; GRAPHDRAWDLGPROC
			   SELECTLISTDLGPROC
