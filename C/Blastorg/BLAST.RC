/*-----------------------------
	BLAST.RC resource script 0892
  -----------------------------*/

#include "blast.h"

Blast ICON "blast.ico"
BLASTBMP BITMAP "igg1.bmp"

AboutBox DIALOG 20, 20, 160, 93
STYLE WS_POPUP | WS_DLGFRAME
CLASS "bordlg"
{
 CTEXT "  Blast\nV 1.0", -1, 55, 10, 55, 17
 ICON "Blast", -1, 8, 8, 13, 13, WS_CHILD | WS_VISIBLE
 CTEXT " Ed Nieuwenhuys, \nRob Aalberse \n feb 1995", -1, 20, 32, 130, 28
 CONTROL "OK", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 70, 74, 26, 16
}



KNOPPEN DIALOG PRELOAD MOVEABLE DISCARDABLE 69, 80, 211, 100
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "Blast Ed Nieuwenhuys/Rob Aalberse"
FONT 10, "System"
{
 PUSHBUTTON "&Select", IDM_SELECT, 161, 4, 45, 16, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Print", IDM_PRINT, 160, 24, 45, 16, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Quit", IDM_CLOSE, 160, 44, 45, 16, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&About", IDM_ABOUTP, 108, 44, 45, 16, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Font", IDC_FONT, 108, 24, 45, 16, WS_GROUP | WS_TABSTOP
 CONTROL "Continuiteits correctie", IDC_FFLAG, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 7, 96, 10
 CONTROL "Log Transformatie", IDC_LOGFLAG, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 19, 96, 10
 CONTROL "Kader", IDC_KADER, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 31, 96, 10
 CONTROL "Header", IDC_HEADER, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 43, 96, 10
 EDITTEXT IDC_YLEGEND, 55, 81, 148, 12
 PUSHBUTTON "Chdir/Load", IDM_LOAD, 108, 4, 45, 16, WS_GROUP | WS_TABSTOP
 CONTROL "", -1, "BorShade", BSS_GROUP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 4, 4, 99, 56
 CONTROL "Y_Legend", -1, "BorStatic", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 83, 44, 9
 CONTROL "", -1, "BorShade", BSS_GROUP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 5, 65, 201, 30
 CONTROL "Max dagen oud", -1, "BorStatic", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 8, 68, 62, 9
 EDITTEXT IDC_MAXDAGOUD, 68, 67, 35, 12
}




ListSelect DIALOG 124, -70, 254, 183
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CLASS "bordlg"
CAPTION "Files zijn max (zie invoerveld) dagen oud"
FONT 12, "System"
{
 CONTROL "Select", 101, "LISTBOX", LBS_NOTIFY | WS_BORDER | LBS_MULTIPLESEL | LBS_HASSTRINGS | LBS_USETABSTOPS | LBS_MULTICOLUMN | LBS_EXTENDEDSEL | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP, 4, 4, 212, 180
 CONTROL "", 1, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 224, 8, 26, 16
}


