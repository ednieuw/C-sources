EDIT_DIALOG DIALOG 43, 92, 187, 67
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CLASS "BorDlg"
CAPTION "Spin Button"
BEGIN
	EDITTEXT CONTROL_BLANK, 
		45, 26, 78, 12, 
		ES_LEFT | WS_CHILD | WS_VISIBLE | 
		    WS_BORDER | WS_TABSTOP
	CONTROL "Button", OK_BUTTON, "BorBtn", 
	   BS_DEFPUSHBUTTON | WS_CHILD | 
		WS_VISIBLE | WS_TABSTOP, 
	   145, 5, 32, 20
	CONTROL "Button", CANCEL_BUTTON, "BorBtn", 
		BS_PUSHBUTTON | WS_CHILD | 
			WS_VISIBLE | WS_TABSTOP, 
		145, 35, 32, 20
	LTEXT "Control id:", -1, 9, 28, 36, 8
	CONTROL "", 107, "BorShade", 
	    1 | WS_CHILD | WS_VISIBLE, 5, 15, 123, 35
	CONTROL "", 109, "BorShade", 
	    3 | WS_CHILD | WS_VISIBLE, 135, 0, 2, 65
END
