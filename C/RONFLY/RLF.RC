IDD_ABOUTBOX DIALOG DISCARDABLE  34, 22, 217, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About RLF"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "RLF Application Version 1.0",IDC_STATIC,40,10,119,8
    LTEXT           "Copyright \251 1994",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,176,6,32,14,WS_GROUP
END

IDD_VUURVLIEG_WAARDEN DIALOG DISCARDABLE  75, 50, 292, 204
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Flash waarden"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Yas blokken:",IDC_STATIC,37,21,57,9
    EDITTEXT        IDC_YAS_BLOK,101,19,18,13,ES_AUTOHSCROLL
    LTEXT           "&Xas blokken:",IDC_STATIC,36,36,57,9,NOT WS_GROUP
    EDITTEXT        IDC_XAS_BLOK,101,34,18,13,ES_AUTOHSCROLL
    LTEXT           "&Start flashes:",IDC_STATIC,172,19,57,9,NOT WS_GROUP
    EDITTEXT        IDC_START_FLASH,236,17,18,13,ES_AUTOHSCROLL
    LTEXT           "&Max waarde rest:",IDC_STATIC,172,34,57,9,NOT WS_GROUP
    EDITTEXT        IDC_MAX_WAARDE,236,32,18,13,ES_AUTOHSCROLL
    LTEXT           "&Invloed blokken:",IDC_STATIC,37,60,57,9,NOT WS_GROUP
    EDITTEXT        IDC_INVLOED,101,57,18,13,ES_AUTOHSCROLL
    LTEXT           "M&oeheidsfaktor:",IDC_STATIC,36,75,57,9,NOT WS_GROUP
    EDITTEXT        IDC_MOEHEID,101,72,18,13,ES_AUTOHSCROLL
    LTEXT           "&Energiefaktor:",IDC_STATIC,172,59,57,9,NOT WS_GROUP
    EDITTEXT        IDC_ENERGIE,236,57,18,13,ES_AUTOHSCROLL
    LTEXT           "&Per. autoerbij:",IDC_STATIC,172,75,57,9,NOT WS_GROUP
    EDITTEXT        IDC_PER_ERBIJ,236,72,18,13,ES_AUTOHSCROLL
    GROUPBOX        "Hoe laden door flash",IDC_STATIC,29,97,99,61
    CONTROL         "Flashende niet laden",IDC_HOEFLASH_0,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,40,115,75,10
    CONTROL         "Iedereen laden",IDC_HOEFLASH_1,"Button",
                    BS_AUTORADIOBUTTON,40,127,75,10
    CONTROL         "Laden naar kleur",IDC_HOEFLASH_2,"Button",
                    BS_AUTORADIOBUTTON,40,139,75,10
    GROUPBOX        "Hoe autoerbij",IDC_STATIC,163,97,99,61
    CONTROL         "Niets erbij",IDC_HOEERBIJ_0,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,175,115,75,10
    CONTROL         "% van treshold",IDC_HOEERBIJ_1,"Button",
                    BS_AUTORADIOBUTTON,175,127,75,10
    CONTROL         "% van vershil",IDC_HOEERBIJ_2,"Button",
                    BS_AUTORADIOBUTTON,175,139,75,10
    DEFPUSHBUTTON   "Restart",IDOK,15,175,50,14,WS_GROUP
    PUSHBUTTON      "Doorgaan",IDDOORGAAN,84,175,50,14
    PUSHBUTTON      "Reset",IDRESET,153,175,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,222,175,50,14
    ICON            IDR_MAINFRAME,IDC_STATIC,10,15,18,20
END


