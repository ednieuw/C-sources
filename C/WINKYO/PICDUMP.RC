#include "picdump.h"

Wcorr ICON "picdump.ico"
//WCORRBMP BITMAP "cero.bmp"

AboutBox DIALOG 20, 20, 160, 80
STYLE WS_POPUP | WS_DLGFRAME
CLASS "bordlg"
{
 CTEXT "  Picdump", -1, 55, 10, 56, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
 CTEXT "Copyright (c) Ed Nieuwenhuys, 1994/95/96/97", -1, 20, 40, 130, 17, WS_CHILD | WS_VISIBLE | WS_GROUP
 CONTROL "OK", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 64, 60, 26, 16
 CTEXT "V 2.0 Mrt 1997", -1, 53, 24, 61, 8
 ICON "Wcorr", -1, 12, 11, 13, 13
}

KNOPPEN DIALOG PRELOAD MOVEABLE DISCARDABLE 45, 15, 173, 137
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION
CLASS "bordlg"
CAPTION "Picdump Ed Nieuwenhuys"
{
 PUSHBUTTON "&Select", IDM_SELECT, 10, 20, 35, 10, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&?About", IDM_ABOUTP, 130, 5, 30, 10, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Print", IDM_PRINT, 50, 35, 35, 10, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "P&ic2Txt", IDM_PIC2PRN, 130, 20, 30, 10, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "T&xt2Pic", IDM_PRN2PIC, 130, 35, 30, 10
 PUSHBUTTON "&Quit", IDM_CLOSE, 10, 5, 75, 10, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
 CONTROL "&1 ", IDM_NOOFGR1, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 20, 95, 15, 10
 CONTROL "&2 ", IDM_NOOFGR2, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 45, 95, 15, 10
 CONTROL "&6", IDM_NOOFGR6, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 70, 95, 15, 10
 CONTROL "&8", IDM_NOOFGR8, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 90, 95, 15, 10
 CONTROL "&9", IDM_NOOFGR9, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 110, 95, 15, 10
 CONTROL "&12", IDM_NOOFGR12, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 129, 95, 20, 10
 EDITTEXT IDM_RESFILE, 100, 60, 60, 12, ES_LEFT | ES_AUTOHSCROLL | ES_UPPERCASE | ES_WANTRETURN | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
 CTEXT "Editor Name", -1, 100, 50, 60, 10, WS_CHILD | WS_VISIBLE | WS_GROUP
 CONTROL "No of graphs / page", 106, "BorShade", BSS_GROUP | BSS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 80, 155, 30
 PUSHBUTTON "&Font", IDM_FONT, 10, 35, 35, 10
 PUSHBUTTON "&View", IDM_VIEW, 90, 20, 35, 10
 PUSHBUTTON "&Drive/Dir", IDM_DRIVEDIR, 50, 20, 35, 10
 CONTROL "Line thickness", -1, "BorShade", BSS_RGROUP | BSS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 50, 85, 22
 CONTROL "1", IDM_LINETHICKNESS1, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 15, 60, 15, 10
 CONTROL "2", IDM_LINETHICKNESS2, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 60, 15, 10
 CONTROL "3", IDM_LINETHICKNESS3, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 55, 60, 15, 10
 CONTROL "4", IDM_LINETHICKNESS4, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 75, 60, 15, 10
 CONTROL "", -1, "BorShade", BSS_HDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 10, 90, 155, 2
 GROUPBOX "", IDC_GROUPBOX1, 10, 110, 153, 25, BS_GROUPBOX
 CONTROL "Portrait", IDM_PORTRAIT, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 20, 120, 50, 10
 CONTROL "&LandScape", IDM_LANDSCAPE, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 100, 120, 55, 10
 PUSHBUTTON "Disk&Name", IDM_VOLUMENAAM, 90, 35, 35, 10
 PUSHBUTTON "&A:", IDM_DRIVEA, 90, 5, 15, 10
 PUSHBUTTON "&B:", IDM_DRIVEB, 110, 5, 15, 10
}

ListSelect DIALOG 19, 22, 358, 229
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CLASS "bordlg"
CAPTION "Select two or more PIC files with CTRL+Mouseclick"
FONT 12, "System"
{
 CONTROL "Select", 101, "LISTBOX", LBS_NOTIFY | LBS_MULTIPLESEL | LBS_MULTICOLUMN | LBS_EXTENDEDSEL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_HSCROLL, 5, 5, 348, 201
 PUSHBUTTON "&Copy to 1st position", IDC_MOVE, 168, 210, 105, 14
 CONTROL "OK", 1, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 63, 210, 26, 16
}


INPUTDIALOG DIALOG 50, 78, 111, 83
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CLASS "BorDlg_Gray"
CAPTION "Disk volume name"
FONT 8, "MS Sans Serif"
{
 CONTROL "", -1, "BorShade", BSS_HDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 0, 56, 189, 3
 EDITTEXT IDM_INPUT, 20, 33, 65, 12
 CONTROL "", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 20, 65, 37, 25
 CONTROL "", IDCANCEL, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 76, 65, 37, 25
 CTEXT "11 characters maximal", -1, 5, 5, 102, 11
}

